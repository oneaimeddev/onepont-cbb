NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret used for normalized private photo writes.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. When unset, the Intelligence composer stays disabled.
# OpenAI-compatible Chat Completions. The key never reaches the browser.
# A model id that starts with gemini uses the Gemini API unless BASE_URL is set.
CBB_INTELLIGENCE_API_KEY=
CBB_INTELLIGENCE_MODEL=gpt-4.1-mini
# CBB_INTELLIGENCE_BASE_URL=https://api.openai.com/v1
# Voice needs a Gemini model and no BASE_URL. Set to false to turn it off.
# CBB_VOICE_ENABLED=true
