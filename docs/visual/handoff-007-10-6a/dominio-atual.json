  "constraints": [
    {
      "name": "athlete_access_athlete_id_fkey",
      "definition": "FOREIGN KEY (athlete_id) REFERENCES clinical.athletes(id) ON DELETE CASCADE",
      "table_name": "clinical.athlete_access"
    },
    {
      "name": "athlete_access_granted_by_fkey",
      "definition": "FOREIGN KEY (granted_by) REFERENCES profiles(id)",
      "table_name": "clinical.athlete_access"
    },
    {
      "name": "athlete_access_pkey",
      "definition": "PRIMARY KEY (athlete_id, professional_id)",
      "table_name": "clinical.athlete_access"
    },
    {
      "name": "athlete_access_professional_id_fkey",
      "definition": "FOREIGN KEY (professional_id) REFERENCES profiles(id) ON DELETE CASCADE",
      "table_name": "clinical.athlete_access"
    },
    {
      "name": "document_revisions_document_id_fkey",
      "definition": "FOREIGN KEY (document_id) REFERENCES clinical.documents(id) ON DELETE CASCADE",
      "table_name": "clinical.document_revisions"
    },
    {
      "name": "document_revisions_pkey",
      "definition": "PRIMARY KEY (document_id, version)",
      "table_name": "clinical.document_revisions"
    },
    {
      "name": "document_revisions_version_check",
      "definition": "CHECK ((version >= 1))",
      "table_name": "clinical.document_revisions"
    },
    {
      "name": "documents_athlete_id_fkey",
      "definition": "FOREIGN KEY (athlete_id) REFERENCES clinical.athletes(id) ON DELETE CASCADE",
      "table_name": "clinical.documents"
    },
    {
      "name": "documents_author_id_fkey",
      "definition": "FOREIGN KEY (author_id) REFERENCES profiles(id)",
      "table_name": "clinical.documents"
    },
    {
      "name": "documents_document_type_check",
      "definition": "CHECK ((document_type = ANY (ARRAY['prescription'::text, 'surgical_order'::text, 'exam_request'::text])))",
      "table_name": "clinical.documents"
    },
    {
      "name": "documents_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "clinical.documents"
    },
    {
      "name": "documents_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['draft'::text, 'ready_for_review'::text])))",
      "table_name": "clinical.documents"
    },
    {
      "name": "documents_version_check",
      "definition": "CHECK ((version >= 1))",
      "table_name": "clinical.documents"
    },
    {
      "name": "medical_authors_credential_label_check",
      "definition": "CHECK (((credential_label IS NULL) OR ((length(TRIM(BOTH FROM credential_label)) >= 1) AND (length(TRIM(BOTH FROM credential_label)) <= 80))))",
      "table_name": "clinical.medical_authors"
    },
    {
      "name": "medical_authors_pkey",
      "definition": "PRIMARY KEY (professional_id)",
      "table_name": "clinical.medical_authors"
    },
    {
      "name": "medical_authors_professional_id_fkey",
      "definition": "FOREIGN KEY (professional_id) REFERENCES profiles(id) ON DELETE CASCADE",
      "table_name": "clinical.medical_authors"
    },
    {
      "name": "profiles_display_name_check",
      "definition": "CHECK (((length(TRIM(BOTH FROM display_name)) >= 1) AND (length(TRIM(BOTH FROM display_name)) <= 120)))",
      "table_name": "profiles"
    },
    {
      "name": "profiles_id_fkey",
      "definition": "FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE",
      "table_name": "profiles"
    },
    {
      "name": "profiles_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "profiles"
    },
    {
      "name": "profiles_profession_check",
      "definition": "CHECK (((length(TRIM(BOTH FROM profession)) >= 1) AND (length(TRIM(BOTH FROM profession)) <= 120)))",
      "table_name": "profiles"
    }
  ],
  "profile_grants": [
